# Copie para .env e preencha. Nunca commite o .env.

# Caminhos (opcionais)
DESPESA_ABERTA_DB=data/despesa-aberta.duckdb
DESPESA_ABERTA_CONFIG=config.toml

# Publicação: só publica de verdade com PUBLICAR=1 (padrão: dry-run)
PUBLICAR=0
# Redes em que publicar, separadas por vírgula (vazio = todas): bluesky,x,mastodon
REDES_ATIVAS=

# X (API v2, OAuth 1.0a user context)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Bluesky (use uma senha de app: Configurações > Senhas de app)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
